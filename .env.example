# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT — copy this file to .env and adjust values
# .env is git-ignored. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Server
APP_PORT=8080

# Database (local Docker)
DB_PASSWORD=local-ecom-password
MYSQL_ROOT_PASSWORD=local-root-password

# JWT — generate a real one: openssl rand -base64 32
JWT_SECRET=bG9jYWwtZGV2ZWxvcG1lbnQtb25seS1zZWNyZXQtMzItYnl0ZXM=

# Grafana (local dashboard)
GRAFANA_PASSWORD=local-grafana-password

# Redis SSL (for Upstash / cloud Redis — leave false for local Docker)
SPRING_DATA_REDIS_SSL_ENABLED=false

# CORS — comma-separated allowed origins (empty = deny all cross-origin)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300,http://localhost:3000

# Email (optional — set MAIL_ENABLED=true to send real emails)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# OAuth2 (optional — leave empty to disable social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# VNPay (optional — sandbox credentials from sandbox.vnpayment.vn)
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION / RENDER DEPLOYMENT — set these as env vars in Render dashboard
# ─────────────────────────────────────────────────────────────────────────────
# DB_URL=jdbc:mysql://<host>/<db>?useSSL=true&serverTimezone=UTC
# DB_USERNAME=<planetscale-username>
# DB_PASSWORD=<planetscale-password>
# JWT_SECRET=<openssl rand -base64 32>
# REDIS_HOST=<upstash-endpoint>
# REDIS_PORT=6379
# REDIS_PASSWORD=<upstash-password>
# SPRING_DATA_REDIS_SSL_ENABLED=true
# SPRINGDOC_SWAGGER_UI_ENABLED=true   # enable Swagger on demo deployment
# CORS_ALLOWED_ORIGINS=https://your-frontend.com